# Odyssey settings used by pilot.py (Mac side) and job.sbatch (cluster side).
# Personal overrides go in config.local.env (not committed).
ODY_HOST=mee
ODY_USER=m19beauc
# Fresh copy of the code, synced by rsync from the Mac. Must end with 4dvarnet-starter-iclr.
ODY_REPO=/Odyssey/private/m19beauc/iclr-rebuttal/4dvarnet-starter-iclr
# Existing clone holding the checkpoints of the submitted paper (FM/DynFM teachers). Set after p0_inventory.
ODY_OLD=
ODY_DATA=/Odyssey/private/m19beauc/4dvarnet-starter-devs/data
ODY_CONDA_ENV=/Odyssey/private/m19beauc/conda_envs/4dvarnet-starter
SLURM_PARTITION=Odyssey_GPU
SLURM_ACCOUNT=odyssey
SLURM_GRES=gpu:h100:1
SLURM_CPUS=12
GIT_BRANCH=rebuttal-iclr
