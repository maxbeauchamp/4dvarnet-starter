# Odyssey settings used by pilot.py (Mac side) and job.sbatch (cluster side).
# Personal overrides go in config.local.env (not committed).
ODY_HOST=mee
ODY_USER=m19beauc
# Git worktree of the branch on Odyssey (checkpoints logs_* and data/ live there, untracked).
# SYNC_MODE=git: each sync fast-forwards it to origin/$GIT_BRANCH (rsync: legacy copy, ODY_REPO must end with 4dvarnet-starter-iclr).
ODY_REPO=/Odyssey/private/m19beauc/4dvarnet-starter-devs
SYNC_MODE=git
# Paths committed by `pilot.py push` (comma-separated; results, runs/ and RUNLOG.md stay local by default)
PUSH_PATHS=
ODY_DATA=/Odyssey/private/m19beauc/4dvarnet-starter-devs/data
ODY_CONDA_ENV=/Odyssey/private/m19beauc/conda_envs/4dvarnet-starter
SLURM_PARTITION=Odyssey_GPU
SLURM_ACCOUNT=odyssey
SLURM_GRES=gpu:a100:1
# Choice per job (pilot.choose_resources): H100 if it starts as early, else A100; avoid nodes 206-207 if possible.
SLURM_GRES_CHOICES=gpu:h100:1,gpu:a100:1
SLURM_EXCLUDE=sl-mee-br-206,sl-mee-br-207
SLURM_CPUS=12
GIT_BRANCH=consistency_models
